[Unit]
Description=Nathan AI Calling loopback CONNECT-normalizing proxy shim
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# Instance adaptation (Oct 29, 2026): this VM has no hatch user; services run as root.
User=root
Group=root
WorkingDirectory=/home/hatch/workspace/ai-calling/server
# Loopback only: the shim binds 127.0.0.1:18080 and forwards CONNECT
# unauthenticated to the VM egress proxy. No credentials are stored
# or read by this unit. See server/proxy_shim.py for the rationale.
ExecStart=/usr/bin/python3 proxy_shim.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
MemoryMax=256M
TasksMax=96
CPUQuota=100%
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
