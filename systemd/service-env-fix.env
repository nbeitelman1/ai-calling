# Candidate service env fix (Oct 30, 2026) — read LAST in the unit EnvironmentFile
# chain so these values win at spawn: sanitized proxy-bypass list (the egress
# file carries a bare ::1 that httpx cannot parse) + system TLS store (certifi
# lacks the egress proxy CA). Proven offline: logs/offline-qa/httpx-probe-20261030.txt
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
